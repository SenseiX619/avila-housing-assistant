# 1. Copy this file and rename the copy to:  .env
# 2. Paste your free Groq key after the = sign (get one at console.groq.com)
GROQ_API_KEY=paste-your-groq-key-here

# 3. Optional - email every new ticket. Sent from a Gmail account with a Gmail "app password"
#    (Google Account > Security > 2-Step Verification > App passwords). Leave empty for no emails.
TICKET_EMAIL_TO=
SMTP_USER=
SMTP_APP_PASSWORD=
